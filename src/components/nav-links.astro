---
import { cn } from "@/lib/utils"

const pathname = Astro.url.pathname
---

<nav
    class="hidden items-center gap-5 md:flex"
    data-testid="nav-links"
>
    <a
        href="/pdf"
        class={cn(
            "text-sm text-muted-foreground transition-colors hover:text-foreground [&.active]:font-medium [&.active]:text-foreground",
            {
                active: pathname.includes("/pdf"),
            }
        )}
    >
        PDF Tools
    </a>
    <a
        href="/qr"
        class={cn(
            "text-sm text-muted-foreground transition-colors hover:text-foreground [&.active]:font-medium [&.active]:text-foreground",
            {
                active: pathname.includes("/qr"),
            }
        )}
    >
        QR Tools
    </a>
</nav>
